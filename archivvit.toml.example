data_dir = "data"
subreddits = ["NixOS"]
posts_per_sub = 25
# Thread re-fetches, in hours after the first one.
refetch_hours = [2, 12]
# Only fetch threads of posts seen in hot within this many hours.
hot_window_hours = 24
# Extra requests (other sorts, more replies, continue thread) per thread fetch.
max_thread_requests = 30
min_delay = 2.0
max_delay = 5.0
ratelimit_floor = 20
